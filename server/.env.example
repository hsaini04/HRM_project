# Copy this file to server/.env and adjust if needed. Never commit the real .env file.

# Port for the Express API
PORT=5050

# Local MongoDB (default install / Windows service). Use your own URI for MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/lutron_skillbridge

# Origin(s) of the React dev server, comma-separated, for CORS
CLIENT_URL=http://localhost:5173

NODE_ENV=development

# Create the default HR, Manager and Employee demo accounts on startup when they are missing
# (an empty database gets the full demo dataset). Set to false to turn this off.
AUTO_SEED=true
